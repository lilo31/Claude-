<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#b89a6a">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}
    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Pagina {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}
    {{ content_for_header }}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,600&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600;9..40,700&display=swap" rel="stylesheet">
    {{ 'theme.css' | asset_url | stylesheet_tag }}
  </head>
  <body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}-{{ template.suffix }}{% endif %}">
    <a class="skip-link" href="#MainContent">Ga naar inhoud</a>
    {% section 'announcement-bar' %}
    {% section 'header' %}
    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>
    {% section 'footer' %}

    <!-- Cart Drawer -->
    <div id="CartDrawer" class="cart-drawer" aria-hidden="true" role="dialog" aria-label="Winkelwagen">
      <div class="cart-drawer__overlay" onclick="LeumxTheme.cart.closeDrawer()"></div>
      <div class="cart-drawer__panel">
        <div class="cart-drawer__header">
          <h2 class="cart-drawer__title">Winkelwagen <span id="CartBadgeDrawer" class="cart-badge-inline"></span></h2>
          <button class="icon-btn" onclick="LeumxTheme.cart.closeDrawer()" aria-label="Sluit">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M13.5 4.5L4.5 13.5M4.5 4.5l9 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          </button>
        </div>
        <div class="cart-drawer__body" id="CartDrawerBody">
          <div class="cart-drawer__empty">
            <svg width="52" height="52" viewBox="0 0 52 52" fill="none"><path d="M7 7h5l6.5 26h21l4.5-18H14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><circle cx="22" cy="39" r="2.5" stroke="currentColor" stroke-width="1.5"/><circle cx="34" cy="39" r="2.5" stroke="currentColor" stroke-width="1.5"/></svg>
            <p class="cart-drawer__empty-text">Uw winkelwagen is leeg</p>
            <button class="btn btn--gold" onclick="LeumxTheme.cart.closeDrawer()">Verder winkelen</button>
          </div>
        </div>
        <div class="cart-drawer__footer" id="CartDrawerFooter">
          <div class="cart-drawer__usp">&#10003;&nbsp; Gratis verzending vanaf &euro;49</div>
          <div class="cart-drawer__subtotal">
            <span>Subtotaal</span>
            <strong id="CartSubtotal"></strong>
          </div>
          <p class="cart-drawer__note">Verzendkosten berekend bij checkout</p>
          <a href="/checkout" class="btn btn--gold btn--full">Afrekenen</a>
          <a href="/cart" class="btn btn--outline btn--full" style="margin-top:10px">Winkelwagen</a>
        </div>
      </div>
    </div>

    <!-- Search Overlay -->
    <div id="SearchOverlay" class="search-overlay" aria-hidden="true">
      <div class="search-overlay__backdrop" onclick="LeumxTheme.search.close()"></div>
      <div class="search-overlay__panel">
        <form action="/search" method="get" role="search">
          <input type="hidden" name="type" value="product">
          <div class="search-overlay__row">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.5"/><path d="M13 13l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            <input type="search" name="q" id="SearchInput" placeholder="Zoek naar producten, merken of categorieën…" class="search-overlay__input" autocomplete="off">
            <button type="button" class="search-overlay__close" onclick="LeumxTheme.search.close()">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M12 4L4 12M4 4l8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              Sluiten
            </button>
          </div>
        </form>
        <div class="search-overlay__suggestions">
          <p class="search-overlay__label">Populaire zoekopdrachten</p>
          <div class="search-overlay__tags">
            <a href="/search?type=product&q=pannen+set" class="search-tag">Pannen set</a>
            <a href="/search?type=product&q=koksmes" class="search-tag">Koksmes</a>
            <a href="/search?type=product&q=gietijzer" class="search-tag">Gietijzeren pan</a>
            <a href="/search?type=product&q=espressomachine" class="search-tag">Espressomachine</a>
            <a href="/search?type=product&q=snijplank" class="search-tag">Snijplank</a>
            <a href="/search?type=product&q=wok" class="search-tag">Wok</a>
          </div>
        </div>
      </div>
    </div>

    {{ 'theme.js' | asset_url | script_tag }}
  </body>
</html>
