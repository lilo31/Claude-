<section class="hero hero--{{ section.settings.content_alignment }}" style="min-height: {{ section.settings.min_height }}vh;">

  <!-- Background Media -->
  <div class="hero__media">
    {% if section.settings.video_url != blank %}
      <video autoplay muted loop playsinline poster="{{ section.settings.image | img_url: '1920x' }}">
        <source src="{{ section.settings.video_url }}">
      </video>
    {% elsif section.settings.image != blank %}
      <img src="{{ section.settings.image | img_url: '1920x' }}"
           alt="{{ section.settings.image.alt | default: shop.name }}"
           loading="eager"
           width="1920"
           height="1080">
    {% else %}
      <div style="background: linear-gradient(135deg, #1a1a1a 0%, #0a0a0a 100%); width: 100%; height: 100%;"></div>
    {% endif %}
  </div>

  <!-- Overlay -->
  <div class="hero__overlay" style="background: {{ section.settings.overlay_color }}; opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>

  <!-- Content -->
  <div class="hero__content">
    <div class="container">
      <div class="hero__inner">

        {% if section.settings.eyebrow != blank %}
          <span class="hero__eyebrow">{{ section.settings.eyebrow }}</span>
        {% endif %}

        {% if section.settings.title != blank %}
          <h1 class="hero__title">{{ section.settings.title }}</h1>
        {% endif %}

        {% if section.settings.subtitle != blank %}
          <p class="hero__subtitle">{{ section.settings.subtitle }}</p>
        {% endif %}

        <div class="hero__actions">
          {% if section.settings.btn_primary_label != blank %}
            <a href="{{ section.settings.btn_primary_url }}" class="btn btn--primary btn--lg">
              {{ section.settings.btn_primary_label }}
            </a>
          {% endif %}
          {% if section.settings.btn_secondary_label != blank %}
            <a href="{{ section.settings.btn_secondary_url }}" class="btn btn--ghost">
              {{ section.settings.btn_secondary_label }}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12,5 19,12 12,19"></polyline>
              </svg>
            </a>
          {% endif %}
        </div>

      </div>
    </div>
  </div>

  {% if section.settings.show_scroll_indicator %}
    <div class="hero__scroll">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </div>
  {% endif %}

</section>

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL (MP4)",
      "info": "Overrides the image if provided"
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#0a0a0a"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "default": 50,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "New Collection"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Heading",
      "default": "<p>Wear Your <em>Story</em></p>"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Curated pieces crafted from the world's finest materials. Designed for those who believe style is a form of self-expression."
    },
    {
      "type": "text",
      "id": "btn_primary_label",
      "label": "Primary button label",
      "default": "Explore Collection"
    },
    {
      "type": "url",
      "id": "btn_primary_url",
      "label": "Primary button URL"
    },
    {
      "type": "text",
      "id": "btn_secondary_label",
      "label": "Secondary button label",
      "default": "Our Story"
    },
    {
      "type": "url",
      "id": "btn_secondary_url",
      "label": "Secondary button URL"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "min": 40,
      "max": 100,
      "step": 5,
      "default": 100,
      "unit": "vh"
    },
    {
      "type": "checkbox",
      "id": "show_scroll_indicator",
      "label": "Show scroll indicator",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
