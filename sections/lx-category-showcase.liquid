{%- comment -%}
  LEUMX — Category showcase
  3–4 large image tiles linking to collections (Kitchenware, Cookware, Electric, Home).
  Navy overlay, gold hairline eyebrow, gold underline reveal on the tile name.
  Block-driven so merchants add/remove/reorder tiles. RTL-aware.
{%- endcomment -%}

<section class="lx-cats" style="--surface: {{ section.settings.bg }};">
  <div class="lx-wrap">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <header class="lx-cats__head">
        {%- if section.settings.eyebrow != blank -%}
          <span class="lx-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="lx-display lx-cats__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </header>
    {%- endif -%}

    <div class="lx-cats__grid" data-count="{{ section.blocks.size }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign coll = block.settings.collection
          assign img = block.settings.image
          if img == blank and coll != blank
            assign img = coll.featured_image
          endif
          assign url = block.settings.link
          if url == blank and coll != blank
            assign url = coll.url
          endif
          assign label = block.settings.title
          if label == blank and coll != blank
            assign label = coll.title
          endif
        -%}
        <a class="lx-cat{% if block.settings.large %} lx-cat--large{% endif %}"
           href="{{ url | default: '#' }}" {{ block.shopify_attributes }}>
          <div class="lx-cat__media">
            {%- if img != blank -%}
              {{ img | image_url: width: 1200 | image_tag:
                 loading: 'lazy', class: 'lx-cat__img',
                 widths: '400,600,800,1200',
                 sizes: '(min-width: 990px) 40vw, 90vw' }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'lx-cat__img lx-cat__img--ph' }}
            {%- endif -%}
            <span class="lx-cat__scrim" aria-hidden="true"></span>
          </div>
          <div class="lx-cat__body">
            {%- if block.settings.kicker != blank -%}
              <span class="lx-cat__kicker">{{ block.settings.kicker }}</span>
            {%- endif -%}
            <h3 class="lx-cat__name lx-display">{{ label | default: 'Category' }}</h3>
            {%- if block.settings.cta != blank -%}
              <span class="lx-cat__cta">{{ block.settings.cta }} <span aria-hidden="true">→</span></span>
            {%- endif -%}
          </div>
        </a>
      {%- else -%}
        <p class="lx-cats__empty">Add tiles in the theme editor to feature your collections.</p>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .lx-cats { background: var(--surface, var(--lx-cream)); color: var(--lx-ink); padding-block: var(--lx-space); }
  .lx-cats__head { margin-block-end: clamp(2rem, 4vw, 3.5rem); max-inline-size: 46rem; }
  .lx-cats__title { font-size: var(--lx-h2); margin: 1rem 0 0; }

  .lx-cats__grid { display: grid; gap: clamp(1rem, 2vw, 1.75rem); grid-template-columns: 1fr; }
  @media (min-width: 750px) { .lx-cats__grid { grid-template-columns: repeat(2, 1fr); } }
  /* When 3 tiles: keep 3-up on desktop; 4 tiles: 4-up */
  @media (min-width: 990px) {
    .lx-cats__grid[data-count="3"] { grid-template-columns: repeat(3, 1fr); }
    .lx-cats__grid[data-count="4"] { grid-template-columns: repeat(4, 1fr); }
  }

  .lx-cat {
    position: relative; display: block; text-decoration: none; color: var(--lx-cream);
    border-radius: var(--lx-radius); overflow: hidden; isolation: isolate;
  }
  .lx-cat--large { grid-column: span 1; }
  @media (min-width: 750px) { .lx-cat--large { grid-column: span 2; } }

  .lx-cat__media { position: relative; aspect-ratio: 4 / 5; overflow: hidden; background: var(--lx-navy); }
  .lx-cat--large .lx-cat__media { aspect-ratio: 16 / 10; }
  .lx-cat__img { inline-size: 100%; block-size: 100%; object-fit: cover; display: block; transition: transform .7s ease; }
  .lx-cat__img--ph { object-fit: contain; background: var(--lx-navy-soft); }
  .lx-cat:hover .lx-cat__img { transform: scale(1.05); }
  .lx-cat__scrim {
    position: absolute; inset: 0;
    background: linear-gradient(0deg, rgba(10,21,38,.86) 0%, rgba(10,21,38,.35) 45%, rgba(10,21,38,.05) 100%);
  }

  .lx-cat__body {
    position: absolute; inset-inline: 0; inset-block-end: 0;
    padding: clamp(1.25rem, 3vw, 2rem);
  }
  .lx-cat__kicker {
    display: inline-block; font-family: var(--lx-body); font-size: .68rem; font-weight: 600;
    letter-spacing: .2em; text-transform: uppercase; color: var(--lx-gold); margin-block-end: .5rem;
  }
  .lx-cat__name {
    font-size: clamp(1.4rem, 1.1rem + 1vw, 2rem); margin: 0; color: var(--lx-cream);
    display: inline; background-image: linear-gradient(var(--lx-gold), var(--lx-gold));
    background-size: 0% 1px; background-repeat: no-repeat; background-position: 0 100%;
    transition: background-size .35s ease; padding-block-end: 3px;
  }
  [dir="rtl"] .lx-cat__name { background-position: 100% 100%; }
  .lx-cat:hover .lx-cat__name, .lx-cat:focus-visible .lx-cat__name { background-size: 100% 1px; }
  .lx-cat__cta {
    display: block; margin-block-start: .75rem; font-family: var(--lx-body);
    font-size: .8rem; letter-spacing: .08em; text-transform: uppercase; color: rgba(246,243,236,.85);
  }
  .lx-cat:focus-visible { outline: 2px solid var(--lx-gold); outline-offset: 3px; }
  .lx-cats__empty { color: var(--lx-ink-soft); font-family: var(--lx-body); }
</style>

{% schema %}
{
  "name": "Leumx Categories",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Explore the range" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everything the kitchen needs" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#F6F3EC" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image (overrides collection image)" },
        { "type": "text", "id": "title", "label": "Title (overrides collection title)" },
        { "type": "text", "id": "kicker", "label": "Kicker" },
        { "type": "text", "id": "cta", "label": "CTA label", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Link (overrides collection URL)" },
        { "type": "checkbox", "id": "large", "label": "Wide tile (spans 2 columns)", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Leumx Categories",
      "blocks": [
        { "type": "tile", "settings": { "title": "Kitchenware", "kicker": "Everyday" } },
        { "type": "tile", "settings": { "title": "Cookware", "kicker": "Signature" } },
        { "type": "tile", "settings": { "title": "Electric", "kicker": "Powered" } },
        { "type": "tile", "settings": { "title": "Home", "kicker": "Living" } }
      ]
    }
  ]
}
{% endschema %}
