{%- comment -%}
  LEUMX — Footer
  Deep-navy surface, gold hairline dividers, newsletter, EN/AR toggle,
  payment icons, B2B / wholesale link. Block-driven link columns.
  RTL-aware via CSS logical properties. Editable from the theme editor.
{%- endcomment -%}

<footer class="lx-footer" role="contentinfo">
  <div class="lx-wrap">

    {%- comment -%} Top: brand + newsletter {%- endcomment -%}
    <div class="lx-footer__top">
      <div class="lx-footer__brand">
        {%- if section.settings.logo != blank -%}
          {{ section.settings.logo | image_url: width: 400 | image_tag:
             loading: 'lazy', class: 'lx-footer__logo',
             widths: '120,200,300,400', sizes: '180px', alt: shop.name,
             style: 'max-block-size: ' | append: section.settings.logo_height | append: 'px;' }}
        {%- else -%}
          <span class="lx-footer__wordmark lx-display">{{ shop.name }}</span>
        {%- endif -%}
        {%- if section.settings.tagline != blank -%}
          <p class="lx-footer__tagline">{{ section.settings.tagline }}</p>
        {%- endif -%}
      </div>

      {%- if section.settings.show_newsletter -%}
        <div class="lx-footer__news">
          {%- if section.settings.news_eyebrow != blank -%}
            <span class="lx-eyebrow">{{ section.settings.news_eyebrow }}</span>
          {%- endif -%}
          {%- if section.settings.news_heading != blank -%}
            <h2 class="lx-display lx-footer__news-title">{{ section.settings.news_heading }}</h2>
          {%- endif -%}
          {%- form 'customer', class: 'lx-footer__form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            {%- if form.posted_successfully? -%}
              <p class="lx-footer__ok">{{ 'newsletter.success' | t | default: 'Thanks — you’re on the list.' }}</p>
            {%- else -%}
              <div class="lx-field">
                <label class="visually-hidden" for="lx-news-email">{{ 'newsletter.email' | t | default: 'Email' }}</label>
                <input id="lx-news-email" type="email" name="contact[email]" required
                  placeholder="{{ section.settings.news_placeholder | default: 'Your email address' }}"
                  autocomplete="email" class="lx-field__input">
                <button type="submit" class="lx-field__btn" aria-label="{{ 'newsletter.subscribe' | t | default: 'Subscribe' }}">
                  {%- render 'lx-icon', icon: 'arrow' -%}
                </button>
              </div>
              {%- if form.errors -%}
                <p class="lx-footer__err">{{ form.errors | default_errors }}</p>
              {%- endif -%}
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}
    </div>

    <div class="lx-footer__rule" role="presentation"></div>

    {%- comment -%} Middle: link columns (blocks) {%- endcomment -%}
    <div class="lx-footer__cols">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            <nav class="lx-footer__col" {{ block.shopify_attributes }} aria-label="{{ block.settings.heading | default: 'Footer' }}">
              {%- if block.settings.heading != blank -%}
                <h3 class="lx-footer__col-title">{{ block.settings.heading }}</h3>
              {%- endif -%}
              {%- if block.settings.menu != blank and linklists[block.settings.menu].links.size > 0 -%}
                <ul class="lx-footer__links" role="list">
                  {%- for link in linklists[block.settings.menu].links -%}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </nav>
          {%- when 'text' -%}
            <div class="lx-footer__col" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h3 class="lx-footer__col-title">{{ block.settings.heading }}</h3>
              {%- endif -%}
              {%- if block.settings.body != blank -%}
                <div class="lx-footer__text">{{ block.settings.body }}</div>
              {%- endif -%}
              {%- if block.settings.b2b_label != blank -%}
                <a class="lx-footer__b2b" href="{{ block.settings.b2b_link }}">
                  {%- render 'lx-icon', icon: 'sparkle' -%}<span>{{ block.settings.b2b_label }}</span>
                </a>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="lx-footer__rule" role="presentation"></div>

    {%- comment -%} Bottom: language, payments, legal {%- endcomment -%}
    <div class="lx-footer__bottom">
      <div class="lx-footer__bottom-start">
        {%- if section.settings.show_language and localization.available_languages.size > 1 -%}
          {%- form 'localization', class: 'lx-footer__lang' -%}
            {%- render 'lx-icon', icon: 'globe' -%}
            <ul role="list" class="lx-footer__lang-list">
              {%- for lang in localization.available_languages -%}
                <li>
                  <button type="submit" name="locale_code" value="{{ lang.iso_code }}" lang="{{ lang.iso_code }}"
                    class="lx-footer__lang-opt{% if lang.iso_code == localization.language.iso_code %} is-active{% endif %}">
                    {{ lang.endonym_name | capitalize }}
                  </button>
                </li>
              {%- endfor -%}
            </ul>
          {%- endform -%}
        {%- endif -%}
        <p class="lx-footer__legal">
          © {{ 'now' | date: '%Y' }} {{ shop.name }}{% if section.settings.legal_extra != blank %} · {{ section.settings.legal_extra }}{% endif %}
        </p>
      </div>

      {%- if section.settings.show_payments and shop.enabled_payment_types.size > 0 -%}
        <ul class="lx-footer__pay" role="list" aria-label="{{ 'general.payment_methods' | t | default: 'Payment methods' }}">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'lx-footer__pay-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

<style>
  .lx-footer {
    background: var(--lx-navy-deep);
    color: rgba(246,243,236,.82);
    font-family: var(--lx-body);
    padding-block: var(--lx-space) 2.5rem;
  }
  .lx-footer a { color: inherit; text-decoration: none; transition: color .2s ease; }
  .lx-footer a:hover { color: var(--lx-gold); }
  .lx-footer :focus-visible { outline: 2px solid var(--lx-gold); outline-offset: 2px; }

  .lx-footer__top {
    display: grid; gap: clamp(2rem, 5vw, 4rem);
    grid-template-columns: 1fr;
    align-items: start;
  }
  @media (min-width: 750px) { .lx-footer__top { grid-template-columns: 1.1fr 1fr; } }

  .lx-footer__wordmark { color: var(--lx-cream); font-size: 1.75rem; letter-spacing: .04em; text-transform: uppercase; }
  .lx-footer__logo { display: block; inline-size: auto; }
  .lx-footer__tagline { margin: 1rem 0 0; max-inline-size: 26rem; line-height: 1.6; font-size: .95rem; }

  .lx-footer__news-title { color: var(--lx-cream); font-size: var(--lx-h3); margin: .9rem 0 1.25rem; }
  .lx-field { display: flex; align-items: stretch; max-inline-size: 26rem; border: 1px solid rgba(195,154,78,.4); border-radius: var(--lx-radius); overflow: hidden; }
  .lx-field__input {
    flex: 1; min-inline-size: 0; background: transparent; border: 0; color: var(--lx-cream);
    font-family: var(--lx-body); font-size: .95rem; padding: .9rem 1rem;
  }
  .lx-field__input::placeholder { color: rgba(246,243,236,.5); }
  .lx-field__input:focus { outline: none; }
  .lx-field:focus-within { border-color: var(--lx-gold); }
  .lx-field__btn {
    background: var(--lx-gold); color: var(--lx-navy); border: 0; cursor: pointer;
    padding-inline: 1.1rem; display: grid; place-items: center; transition: background .2s ease;
  }
  .lx-field__btn:hover { background: var(--lx-gold-bright); }
  .lx-field__btn .lx-svg { inline-size: 20px; block-size: 20px; }
  [dir="rtl"] .lx-field__btn .lx-svg { transform: scaleX(-1); }
  .lx-footer__ok { color: var(--lx-gold); }
  .lx-footer__err { color: #E5A3A3; font-size: .85rem; margin-block-start: .5rem; }

  .lx-footer__rule { block-size: 1px; background: linear-gradient(90deg, transparent, rgba(195,154,78,.5), transparent); margin-block: clamp(2rem, 4vw, 3rem); }

  .lx-footer__cols {
    display: grid; gap: 2rem clamp(1.5rem, 3vw, 3rem);
    grid-template-columns: repeat(2, 1fr);
  }
  @media (min-width: 750px) { .lx-footer__cols { grid-template-columns: repeat(4, 1fr); } }
  .lx-footer__col-title {
    color: var(--lx-cream); font-family: var(--lx-body); font-size: .74rem;
    letter-spacing: .18em; text-transform: uppercase; font-weight: 600; margin: 0 0 1.1rem;
  }
  .lx-footer__links { list-style: none; margin: 0; padding: 0; display: grid; gap: .7rem; }
  .lx-footer__links a { font-size: .92rem; }
  .lx-footer__text { font-size: .92rem; line-height: 1.6; }
  .lx-footer__text p { margin: 0 0 .8rem; }
  .lx-footer__b2b {
    display: inline-flex; align-items: center; gap: .5rem; margin-block-start: .4rem;
    color: var(--lx-gold); font-size: .82rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase;
    border: 1px solid rgba(195,154,78,.4); padding: .7rem 1.1rem; border-radius: var(--lx-radius);
  }
  .lx-footer__b2b .lx-svg { inline-size: 16px; block-size: 16px; }
  .lx-footer__b2b:hover { background: rgba(195,154,78,.1); border-color: var(--lx-gold); color: var(--lx-gold); }

  .lx-footer__bottom {
    display: flex; flex-wrap: wrap; gap: 1.25rem; align-items: center; justify-content: space-between;
  }
  .lx-footer__bottom-start { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; }
  .lx-footer__lang { display: inline-flex; align-items: center; gap: .6rem; margin: 0; }
  .lx-footer__lang .lx-svg { inline-size: 18px; block-size: 18px; color: var(--lx-gold); }
  .lx-footer__lang-list { display: inline-flex; gap: .25rem; list-style: none; margin: 0; padding: 0; }
  .lx-footer__lang-opt {
    background: none; border: 0; cursor: pointer; color: rgba(246,243,236,.7);
    font-family: var(--lx-body); font-size: .82rem; padding: .3rem .5rem; border-radius: var(--lx-radius);
  }
  .lx-footer__lang-opt:hover { color: var(--lx-gold); }
  .lx-footer__lang-opt.is-active { color: var(--lx-cream); font-weight: 600; }
  .lx-footer__legal { margin: 0; font-size: .82rem; color: rgba(246,243,236,.55); }

  .lx-footer__pay { display: flex; flex-wrap: wrap; gap: .5rem; list-style: none; margin: 0; padding: 0; }
  .lx-footer__pay-icon { inline-size: 38px; block-size: 24px; border-radius: 3px; }
</style>

{% schema %}
{
  "name": "Leumx Footer",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Brand" },
    { "type": "image_picker", "id": "logo", "label": "Footer logo" },
    { "type": "range", "id": "logo_height", "label": "Logo height (px)", "min": 24, "max": 72, "step": 2, "default": 36 },
    { "type": "textarea", "id": "tagline", "label": "Tagline", "default": "Premium homeware and cookware, engineered to be handed down." },
    { "type": "header", "content": "Newsletter" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter", "default": true },
    { "type": "text", "id": "news_eyebrow", "label": "Eyebrow", "default": "Stay in touch" },
    { "type": "text", "id": "news_heading", "label": "Heading", "default": "Join the Leumx list" },
    { "type": "text", "id": "news_placeholder", "label": "Input placeholder", "default": "Your email address" },
    { "type": "header", "content": "Bottom bar" },
    { "type": "checkbox", "id": "show_language", "label": "Show EN/AR language switch", "default": true },
    { "type": "checkbox", "id": "show_payments", "label": "Show payment icons", "default": true },
    { "type": "text", "id": "legal_extra", "label": "Legal line extra", "default": "All rights reserved." }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "Text / B2B column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Trade" },
        { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Wholesale and B2B partnerships for retailers and hospitality.</p>" },
        { "type": "text", "id": "b2b_label", "label": "B2B button label", "default": "Wholesale enquiries" },
        { "type": "url", "id": "b2b_link", "label": "B2B link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Leumx Footer",
      "blocks": [
        { "type": "menu", "settings": { "heading": "Shop" } },
        { "type": "menu", "settings": { "heading": "Company" } },
        { "type": "menu", "settings": { "heading": "Support" } },
        { "type": "text" }
      ]
    }
  ]
}
{% endschema %}
