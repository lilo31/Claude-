{% comment %} Homepage — Hero + Features + Featured Products {% endcomment %}

{%- comment -%} ─── HERO ─────────────────────────────────────────────────── {%- endcomment -%}
<section class="hero">
  {%- if section.settings.hero_image != blank -%}
    <img
      class="hero__bg"
      src="{{ section.settings.hero_image | image_url: width: 1600 }}"
      alt="{{ section.settings.hero_title }}"
      loading="eager"
      fetchpriority="high"
    >
  {%- else -%}
    <div style="position:absolute;inset:0;background:linear-gradient(135deg, #1e3a18 0%, #3d6b35 50%, #7ab648 100%);opacity:0.8;"></div>
  {%- endif -%}
  <div class="page-width">
    <div class="hero__content">
      <p class="hero__eyebrow animate-fade-up">{{ section.settings.hero_eyebrow }}</p>
      <h1 class="hero__title animate-fade-up animate-delay-1">{{ section.settings.hero_title }}</h1>
      <p class="hero__desc animate-fade-up animate-delay-2">{{ section.settings.hero_subtitle }}</p>
      <div class="hero__actions animate-fade-up animate-delay-3">
        {%- if section.settings.hero_cta_label != blank -%}
          <a href="{{ section.settings.hero_cta_url }}" class="button button--primary button--large">
            {{ section.settings.hero_cta_label }}
          </a>
        {%- endif -%}
        {%- if section.settings.hero_secondary_label != blank -%}
          <a href="{{ section.settings.hero_secondary_url }}" class="button button--secondary button--large" style="color:#fff;border-color:rgba(255,255,255,0.6);">
            {{ section.settings.hero_secondary_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{%- comment -%} ─── FEATURES ROW ─────────────────────────────────────────── {%- endcomment -%}
<div class="features-row">
  <div class="page-width">
    <div class="features-row__grid">
      <div class="features-row__item">
        <svg class="features-row__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <div>
          <p class="features-row__title">Certified Organic</p>
          <p class="features-row__desc">100% non-GMO, open-pollinated</p>
        </div>
      </div>
      <div class="features-row__item">
        <svg class="features-row__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        <div>
          <p class="features-row__title">Free Shipping $50+</p>
          <p class="features-row__desc">Ships within 2-3 business days</p>
        </div>
      </div>
      <div class="features-row__item">
        <svg class="features-row__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
        <div>
          <p class="features-row__title">90%+ Germination</p>
          <p class="features-row__desc">Tested & guaranteed to grow</p>
        </div>
      </div>
      <div class="features-row__item" style="border-right:none">
        <svg class="features-row__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
        <div>
          <p class="features-row__title">Expert Support</p>
          <p class="features-row__desc">Gardening help 7 days a week</p>
        </div>
      </div>
    </div>
  </div>
</div>

{%- comment -%} ─── FEATURED PRODUCTS ────────────────────────────────────── {%- endcomment -%}
{%- if section.settings.featured_collection != blank -%}
  <section class="section">
    <div class="page-width">
      <div class="section-heading animate-fade-up">
        <p class="section-heading__eyebrow">{{ section.settings.collection_eyebrow }}</p>
        <h2 class="section-heading__title">{{ section.settings.collection_title }}</h2>
        <p class="section-heading__subtitle">{{ section.settings.collection_subtitle }}</p>
      </div>
      <div class="grid grid--4-col">
        {%- assign featured_col = collections[section.settings.featured_collection] -%}
        {%- for prod in featured_col.products limit: section.settings.products_to_show -%}
          {%- render 'product-card', product: prod -%}
        {%- endfor -%}
      </div>
      {%- if section.settings.show_view_all -%}
        <div style="text-align:center;margin-top:3.2rem;">
          <a href="{{ featured_col.url }}" class="button button--secondary">View All Seeds</a>
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{%- comment -%} ─── IMAGE + TEXT BLOCK ───────────────────────────────────── {%- endcomment -%}
{%- if section.settings.show_about -%}
  <section class="section" style="background: var(--color-brand-light);">
    <div class="page-width">
      <div class="image-text image-text--reverse">
        <div class="image-text__content animate-fade-up">
          <p class="image-text__eyebrow">Our Story</p>
          <h2 class="image-text__title">{{ section.settings.about_title }}</h2>
          <div class="image-text__body">{{ section.settings.about_text }}</div>
          <div class="image-text__stats">
            <div class="image-text__stat">
              <div class="image-text__stat-number">500+</div>
              <div class="image-text__stat-label">Seed Varieties</div>
            </div>
            <div class="image-text__stat">
              <div class="image-text__stat-number">12K+</div>
              <div class="image-text__stat-label">Happy Growers</div>
            </div>
            <div class="image-text__stat">
              <div class="image-text__stat-number">90%+</div>
              <div class="image-text__stat-label">Germination Rate</div>
            </div>
          </div>
          <a href="{{ section.settings.about_cta_url }}" class="button button--primary">{{ section.settings.about_cta_label }}</a>
        </div>
        <div class="image-text__media animate-fade-up animate-delay-2">
          {%- if section.settings.about_image != blank -%}
            <img src="{{ section.settings.about_image | image_url: width: 800 }}" alt="{{ section.settings.about_title }}" loading="lazy">
          {%- else -%}
            <div style="width:100%;height:100%;background:linear-gradient(135deg, #3d6b35, #7ab648);display:flex;align-items:center;justify-content:center;">
              <svg style="width:8rem;height:8rem;color:rgba(255,255,255,0.5)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M12 22V12M12 12C12 7 8 3 3 3s1 6 5 9M12 12c0-5 4-9 9-9s-1 6-5 9"/></svg>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Homepage Content",
  "settings": [
    {
      "type": "header",
      "content": "Hero Banner"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero background image"
    },
    {
      "type": "text",
      "id": "hero_eyebrow",
      "label": "Eyebrow text",
      "default": "Certified Organic Seeds"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero headline",
      "default": "Grow Your Best Garden Yet"
    },
    {
      "type": "text",
      "id": "hero_subtitle",
      "label": "Hero subheadline",
      "default": "Heirloom, open-pollinated seeds — sustainably grown and rigorously tested for maximum germination."
    },
    {
      "type": "text",
      "id": "hero_cta_label",
      "label": "Primary button label",
      "default": "Shop Seeds"
    },
    {
      "type": "url",
      "id": "hero_cta_url",
      "label": "Primary button URL",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "hero_secondary_label",
      "label": "Secondary button label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "hero_secondary_url",
      "label": "Secondary button URL",
      "default": "/pages/about"
    },
    {
      "type": "header",
      "content": "Featured Collection"
    },
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "collection_eyebrow",
      "label": "Eyebrow",
      "default": "This Season's Picks"
    },
    {
      "type": "text",
      "id": "collection_title",
      "label": "Title",
      "default": "Featured Seeds"
    },
    {
      "type": "text",
      "id": "collection_subtitle",
      "label": "Subtitle",
      "default": "Hand-selected varieties for beginner and experienced gardeners alike."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Products to show"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View All button",
      "default": true
    },
    {
      "type": "header",
      "content": "About / Story Block"
    },
    {
      "type": "checkbox",
      "id": "show_about",
      "label": "Show about block",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "about_image",
      "label": "About image"
    },
    {
      "type": "text",
      "id": "about_title",
      "label": "About title",
      "default": "Seeds Rooted in Tradition, Grown for Tomorrow"
    },
    {
      "type": "richtext",
      "id": "about_text",
      "label": "About text",
      "default": "<p>We're a small family farm dedicated to preserving the world's most remarkable seed varieties. Every packet we sell is grown without synthetic pesticides, tested for viability, and packed with love.</p><p>Whether you're planting your first vegetable garden or expanding a thriving homestead, we have the seeds to help you grow.</p>"
    },
    {
      "type": "text",
      "id": "about_cta_label",
      "label": "CTA button label",
      "default": "Read Our Story"
    },
    {
      "type": "url",
      "id": "about_cta_url",
      "label": "CTA button URL",
      "default": "/pages/about"
    }
  ],
  "presets": [
    {
      "name": "Homepage Content"
    }
  ]
}
{% endschema %}
