{% comment %}
  Main Product Section — Full featured product page
  Supports: variants, selling plans/subscriptions, image gallery, accordions, sticky ATC
{% endcomment %}

{%- liquid
  assign product = section.settings.product | default: product
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'product-form-' | append: section.id
  assign featured_media = current_variant.featured_media | default: product.featured_media
-%}

<div class="product page-width" itemscope itemtype="https://schema.org/Product">
  <meta itemprop="name" content="{{ product.title | escape }}">
  <meta itemprop="url" content="{{ shop.url }}{{ product.url }}">
  <meta itemprop="image" content="{{ product.featured_image | image_url: width: 1200 }}">
  <meta itemprop="description" content="{{ product.description | strip_html | truncate: 300 | escape }}">
  <meta itemprop="brand" content="{{ product.vendor | escape }}">
  <meta itemprop="sku" content="{{ current_variant.sku }}">

  {%- comment -%} Breadcrumbs {%- endcomment -%}
  <nav class="product__breadcrumb" aria-label="Breadcrumb">
    <ol class="breadcrumbs" vocab="https://schema.org/" typeof="BreadcrumbList">
      <li class="breadcrumbs__item" property="itemListElement" typeof="ListItem">
        <a href="{{ routes.root_url }}" class="breadcrumbs__link" property="item" typeof="WebPage">
          <span property="name">Home</span>
        </a>
        <meta property="position" content="1">
        <span class="breadcrumbs__separator" aria-hidden="true">›</span>
      </li>
      {%- if product.collections.first -%}
        <li class="breadcrumbs__item" property="itemListElement" typeof="ListItem">
          <a href="{{ product.collections.first.url }}" class="breadcrumbs__link" property="item" typeof="WebPage">
            <span property="name">{{ product.collections.first.title }}</span>
          </a>
          <meta property="position" content="2">
          <span class="breadcrumbs__separator" aria-hidden="true">›</span>
        </li>
      {%- endif -%}
      <li class="breadcrumbs__item" property="itemListElement" typeof="ListItem">
        <span property="name">{{ product.title }}</span>
        <meta property="position" content="3">
      </li>
    </ol>
  </nav>

  {%- comment -%} Product Layout {%- endcomment -%}
  <div class="product__layout">

    {%- comment -%} ─── LEFT: MEDIA GALLERY ─────────────────────────────── {%- endcomment -%}
    <div class="product__media-wrapper">
      <div class="product__media-main">
        {%- comment -%} Sale / Organic / New badge {%- endcomment -%}
        <div class="product__media-badge">
          {%- if current_variant.compare_at_price > current_variant.price -%}
            {%- assign savings_pct = current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price -%}
            <span class="badge badge--sale">Save {{ savings_pct }}%</span>
          {%- endif -%}
          {%- for tag in product.tags -%}
            {%- if tag == 'organic' or tag == 'Organic' -%}
              <span class="badge badge--organic">Certified Organic</span>
            {%- elsif tag == 'new' or tag == 'New' -%}
              <span class="badge badge--new">New Arrival</span>
            {%- elsif tag == 'heirloom' or tag == 'Heirloom' -%}
              <span class="badge badge--organic" style="background:var(--color-brand-dark)">Heirloom</span>
            {%- endif -%}
          {%- endfor -%}
          {%- unless current_variant.available -%}
            <span class="badge badge--sold-out">Sold Out</span>
          {%- endunless -%}
        </div>

        {%- comment -%} Main image {%- endcomment -%}
        <img
          id="product-main-image"
          data-product-main-image
          src="{{ featured_media | image_url: width: 800 }}"
          srcset="
            {{ featured_media | image_url: width: 400 }} 400w,
            {{ featured_media | image_url: width: 600 }} 600w,
            {{ featured_media | image_url: width: 800 }} 800w,
            {{ featured_media | image_url: width: 1000 }} 1000w
          "
          sizes="(min-width: 990px) 50vw, 100vw"
          alt="{{ featured_media.alt | default: product.title | escape }}"
          width="800"
          height="800"
          loading="eager"
          fetchpriority="high"
          style="width:100%;height:100%;object-fit:cover;transition:opacity 0.3s"
          itemprop="image"
        >

        {%- comment -%} Zoom button {%- endcomment -%}
        <button class="product__media-zoom" data-zoom-btn aria-label="Zoom image">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
        </button>
      </div>

      {%- comment -%} Thumbnails {%- endcomment -%}
      {%- if product.media.size > 1 -%}
        <div class="product__media-thumbnails" role="list">
          {%- for media in product.media -%}
            <button
              class="product__media-thumb{% if forloop.first %} active{% endif %}"
              data-thumbnail
              role="listitem"
              aria-label="{{ media.alt | default: product.title }}"
              aria-pressed="{{ forloop.first }}"
            >
              <img
                src="{{ media | image_url: width: 160 }}"
                alt="{{ media.alt | default: product.title | escape }}"
                width="80"
                height="80"
                loading="lazy"
              >
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} ─── RIGHT: PRODUCT INFO ──────────────────────────────── {%- endcomment -%}
    <div class="product__info" data-product-form-wrapper>

      {%- comment -%} Vendor {%- endcomment -%}
      {%- if product.vendor != blank -%}
        <p class="product__vendor">{{ product.vendor }}</p>
      {%- endif -%}

      {%- comment -%} Title {%- endcomment -%}
      <h1 class="product__title" itemprop="name">{{ product.title }}</h1>

      {%- comment -%} Rating (static/app placeholder) {%- endcomment -%}
      {%- if section.settings.show_rating -%}
        <div class="product__rating">
          <div class="product__rating-stars" aria-label="4.8 out of 5 stars">
            {%- for i in (1..5) -%}
              <svg class="product__rating-star{% if i == 5 %} product__rating-star--empty{% endif %}" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            {%- endfor -%}
          </div>
          <span class="product__rating-count">4.8</span>
          <button class="product__rating-reviews" onclick="document.getElementById('product-reviews').scrollIntoView({behavior:'smooth'})">128 reviews</button>
        </div>
      {%- endif -%}

      {%- comment -%} Product JSON for JS {%- endcomment -%}
      <script type="application/json" data-product-json>
        {{ product | json }}
      </script>

      {%- comment -%} Price row {%- endcomment -%}
      <div class="product__price-row" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
        <meta itemprop="priceCurrency" content="{{ cart.currency.iso_code }}">
        <meta itemprop="availability" content="https://schema.org/{% if current_variant.available %}InStock{% else %}OutOfStock{% endif %}">
        <link itemprop="url" href="{{ shop.url }}{{ product.url }}">

        {%- if current_variant.compare_at_price > current_variant.price -%}
          <span class="product__price product__price--sale" data-price itemprop="price" content="{{ current_variant.price | divided_by: 100.0 }}">
            {{ current_variant.price | money }}
          </span>
          <span class="product__price product__price--compare" data-compare-price>
            {{ current_variant.compare_at_price | money }}
          </span>
          {%- assign savings = current_variant.compare_at_price | minus: current_variant.price -%}
          <span class="product__savings" data-savings>Save {{ savings | money }}</span>
        {%- else -%}
          <span class="product__price" data-price itemprop="price" content="{{ current_variant.price | divided_by: 100.0 }}">
            {{ current_variant.price | money }}
          </span>
          <span class="product__price product__price--compare" data-compare-price style="display:none"></span>
          <span class="product__savings" data-savings style="display:none"></span>
        {%- endif -%}

        {%- if product.variants.size == 1 and product.variants.first.unit_price_measurement -%}
          <span class="product__price-unit">
            {{ product.variants.first.unit_price | money }} / {{ product.variants.first.unit_price_measurement.reference_value }}
            {{ product.variants.first.unit_price_measurement.reference_unit }}
          </span>
        {%- endif -%}
      </div>

      {%- comment -%} FORM {%- endcomment -%}
      {%- form 'product', product, id: product_form_id, novalidate: 'novalidate', data-product-form: '' -%}

        <input type="hidden" name="id" value="{{ current_variant.id }}" data-productid>

        {%- comment -%} ─── SELLING PLANS (Subscriptions) ──────────────────────── {%- endcomment -%}
        {%- if product.selling_plan_groups.size > 0 -%}
          <div class="product__selling-plans">
            <p class="product__selling-plans-title">Purchase Options</p>
            <div class="product__selling-plan-options" role="radiogroup" aria-label="Purchase options">

              {%- comment -%} One-time purchase option {%- endcomment -%}
              <label class="product__selling-plan-option" id="selling-plan-one-time">
                <input type="radio" name="selling_plan" value="" checked aria-label="One-time purchase">
                <div class="product__selling-plan-label">
                  <span class="product__selling-plan-name">One-Time Purchase</span>
                  <span class="product__selling-plan-desc">Buy once, no commitment</span>
                </div>
                <span class="product__selling-plan-price" data-onetime-price>{{ current_variant.price | money }}</span>
              </label>

              {%- for group in product.selling_plan_groups -%}
                {%- for plan in group.selling_plans -%}
                  {%- liquid
                    assign plan_price = current_variant.price
                    assign plan_savings = 0
                    assign has_discount = false
                    for adj in plan.price_adjustments
                      if adj.value_type == 'percentage'
                        assign plan_price = plan_price | times: adj.value | divided_by: 100
                        assign plan_price = current_variant.price | minus: plan_price
                        assign has_discount = true
                      elsif adj.value_type == 'fixed_amount'
                        assign plan_price = current_variant.price | minus: adj.value
                        assign has_discount = true
                      elsif adj.value_type == 'price'
                        assign plan_price = adj.value
                        assign has_discount = true
                      endif
                    endfor
                  -%}
                  <label class="product__selling-plan-option" for="selling-plan-{{ plan.id }}">
                    <input
                      type="radio"
                      name="selling_plan"
                      value="{{ plan.id }}"
                      id="selling-plan-{{ plan.id }}"
                      aria-label="{{ plan.name }}"
                    >
                    <div class="product__selling-plan-label">
                      <span class="product__selling-plan-name">{{ plan.name }}</span>
                      {%- if plan.description != blank -%}
                        <span class="product__selling-plan-desc">{{ plan.description }}</span>
                      {%- else -%}
                        <span class="product__selling-plan-desc">{{ group.name }} — Cancel anytime</span>
                      {%- endif -%}
                    </div>
                    {%- if has_discount -%}
                      {%- for adj in plan.price_adjustments -%}
                        {%- if adj.value_type == 'percentage' -%}
                          <span class="product__selling-plan-badge">Save {{ adj.value }}%</span>
                        {%- endif -%}
                      {%- endfor -%}
                    {%- endif -%}
                    <span class="product__selling-plan-price">{{ plan_price | money }}</span>
                  </label>
                {%- endfor -%}
              {%- endfor -%}

            </div>
          </div>
        {%- endif -%}

        {%- comment -%} ─── VARIANTS / OPTIONS ──────────────────────────────────── {%- endcomment -%}
        {%- unless product.has_only_default_variant -%}
          <div class="product__options">
            {%- for option in product.options_with_values -%}
              <div class="product__option">
                <div class="product__option-title">
                  {{ option.name }}:
                  <span class="product__option-selected" data-option-label="{{ option.name }}">{{ option.selected_value }}</span>
                </div>
                <div class="product__option-values" role="radiogroup" aria-label="{{ option.name }}">
                  {%- for value in option.values -%}
                    {%- liquid
                      assign is_selected = false
                      if value == option.selected_value
                        assign is_selected = true
                      endif
                    -%}
                    <button
                      class="product__option-value{% if is_selected %} selected{% endif %}"
                      data-option="{{ option.name }}"
                      data-value="{{ value }}"
                      aria-label="{{ option.name }}: {{ value }}"
                      aria-pressed="{{ is_selected }}"
                      type="button"
                    >
                      {{ value }}
                    </button>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- endunless -%}

        {%- comment -%} ─── STOCK INDICATOR ─────────────────────────────────────── {%- endcomment -%}
        {%- if section.settings.show_stock_indicator -%}
          <div class="product__stock {% if current_variant.available %}product__stock--in-stock{% else %}product__stock--out-of-stock{% endif %}" data-stock>
            <span class="product__stock-dot"></span>
            <span class="product__stock-text" data-stock-text>
              {%- if current_variant.available -%}
                {%- if current_variant.inventory_quantity > 20 -%}
                  In Stock — Ready to Ship
                {%- elsif current_variant.inventory_quantity > 0 -%}
                  Low Stock — Only {{ current_variant.inventory_quantity }} left
                {%- else -%}
                  In Stock
                {%- endif -%}
              {%- else -%}
                Out of Stock
              {%- endif -%}
            </span>
          </div>
        {%- endif -%}

        {%- comment -%} ─── SHIPPING INFO BANNER ────────────────────────────────── {%- endcomment -%}
        {%- if section.settings.shipping_text != blank -%}
          <div class="product__shipping">
            <svg class="product__shipping-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            <span class="product__shipping-text">{{ section.settings.shipping_text }}</span>
          </div>
        {%- endif -%}

        {%- comment -%} ─── UPSELL BANNER ───────────────────────────────────────── {%- endcomment -%}
        {%- if section.settings.upsell_text != blank -%}
          <div class="product__upsell">
            <p class="product__upsell-label">Bundle & Save</p>
            <p class="product__upsell-text">{{ section.settings.upsell_text }}</p>
          </div>
        {%- endif -%}

        {%- comment -%} ─── QUANTITY + ADD TO CART ──────────────────────────────── {%- endcomment -%}
        <div data-product-atc-section>
          <div class="product__form-row">
            <div class="product__quantity quantity" aria-label="Quantity">
              <button class="quantity__button" type="button" data-quantity-dec aria-label="Decrease quantity">−</button>
              <input
                class="quantity__input"
                type="number"
                name="quantity"
                id="quantity-{{ section.id }}"
                min="1"
                value="1"
                aria-label="Quantity"
              >
              <button class="quantity__button" type="button" data-quantity-inc aria-label="Increase quantity">+</button>
            </div>

            <div class="product__atc">
              <button
                class="product__atc-btn"
                type="submit"
                data-atc-btn
                {% unless current_variant.available %}disabled{% endunless %}
                aria-label="Add {{ product.title }} to cart"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
                <span data-atc-text>
                  {%- if current_variant.available -%}
                    Add to Cart
                  {%- else -%}
                    Sold Out
                  {%- endif -%}
                </span>
              </button>
            </div>
          </div>
        </div>

        {%- comment -%} Dynamic checkout / Buy now {%- endcomment -%}
        {%- if section.settings.show_dynamic_checkout -%}
          {{ form | payment_button }}
        {%- endif -%}

      {%- endform -%}

      {%- comment -%} Wishlist / Save button {%- endcomment -%}
      <button class="product__wishlist-btn" type="button" data-wishlist-btn aria-label="Save to wishlist">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
        Save to Wishlist
      </button>

      {%- comment -%} Trust icons {%- endcomment -%}
      <div class="product__trust">
        <div class="product__trust-item">
          <svg class="product__trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span class="product__trust-label">Secure Checkout</span>
        </div>
        <div class="product__trust-item">
          <svg class="product__trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <span class="product__trust-label">Shipped Fresh</span>
        </div>
        <div class="product__trust-item">
          <svg class="product__trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
          <span class="product__trust-label">90%+ Germination</span>
        </div>
      </div>

      {%- comment -%} Short Description {%- endcomment -%}
      {%- if product.description != blank -%}
        <div class="product__short-desc">
          {{ product.description | strip_html | truncate: 250 }}
        </div>
      {%- endif -%}

      {%- comment -%} Highlights {%- endcomment -%}
      {%- if section.blocks.size > 0 -%}
        <ul class="product__highlights">
          {%- for block in section.blocks -%}
            {%- if block.type == 'highlight' and block.settings.text != blank -%}
              <li class="product__highlight" {{ block.shopify_attributes }}>
                <svg class="product__highlight-icon" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                {{ block.settings.text }}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- comment -%} Share {%- endcomment -%}
      {%- if section.settings.show_share -%}
        <div class="product__share">
          <span class="product__share-label">Share:</span>
          <a
            href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url }}{{ product.url }}"
            class="product__share-btn"
            target="_blank"
            rel="noopener"
            aria-label="Share on Facebook"
          >
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a
            href="https://twitter.com/intent/tweet?url={{ shop.url }}{{ product.url }}&text={{ product.title | url_encode }}"
            class="product__share-btn"
            target="_blank"
            rel="noopener"
            aria-label="Share on Twitter"
          >
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/></svg>
          </a>
          <a
            href="https://pinterest.com/pin/create/button/?url={{ shop.url }}{{ product.url }}&media={{ product.featured_image | image_url: width: 1000 }}&description={{ product.title | url_encode }}"
            class="product__share-btn"
            target="_blank"
            rel="noopener"
            aria-label="Share on Pinterest"
          >
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 01.083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/></svg>
          </a>
        </div>
      {%- endif -%}

      {%- comment -%} ─── PRODUCT DETAIL ACCORDIONS ────────────────────────────── {%- endcomment -%}
      <div class="product__details">

        {%- comment -%} Description {%- endcomment -%}
        {%- if product.description != blank -%}
          <div class="product__details-tab" id="tab-description">
            <button class="product__tab-header" aria-expanded="true" aria-controls="tab-description-content" type="button">
              <span class="product__tab-title">Description</span>
              <svg class="product__tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </button>
            <div class="product__tab-content" id="tab-description-content">
              <div class="product__tab-body rte">
                {{ product.description }}
              </div>
            </div>
          </div>
        {%- endif -%}

        {%- comment -%} Growing Info block {%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'accordion' -%}
            <div class="product__details-tab" {{ block.shopify_attributes }}>
              <button class="product__tab-header" aria-expanded="false" type="button">
                <span class="product__tab-title">{{ block.settings.heading }}</span>
                <svg class="product__tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              </button>
              <div class="product__tab-content">
                <div class="product__tab-body rte">{{ block.settings.content }}</div>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}

        {%- comment -%} Shipping & Returns {%- endcomment -%}
        {%- if section.settings.shipping_policy != blank -%}
          <div class="product__details-tab">
            <button class="product__tab-header" aria-expanded="false" type="button">
              <span class="product__tab-title">Shipping & Returns</span>
              <svg class="product__tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </button>
            <div class="product__tab-content">
              <div class="product__tab-body">{{ section.settings.shipping_policy }}</div>
            </div>
          </div>
        {%- endif -%}

      </div>

    </div>{%- comment -%} end product__info {%- endcomment -%}
  </div>{%- comment -%} end product__layout {%- endcomment -%}

</div>{%- comment -%} end .product {%- endcomment -%}

{%- comment -%} ─── STICKY ADD TO CART BAR ───────────────────────────────── {%- endcomment -%}
{%- if section.settings.show_sticky_atc -%}
  <div class="sticky-atc" id="sticky-atc" aria-hidden="true">
    <div class="sticky-atc__inner">
      <div class="sticky-atc__product">
        {%- if featured_media -%}
          <div class="sticky-atc__image">
            <img src="{{ featured_media | image_url: width: 100 }}" alt="{{ product.title | escape }}" loading="lazy">
          </div>
        {%- endif -%}
        <span class="sticky-atc__title">{{ product.title }}</span>
      </div>
      <span class="sticky-atc__price" data-sticky-price>{{ current_variant.price | money }}</span>
      <button class="sticky-atc__btn" id="sticky-atc-btn" type="button">
        Add to Cart
      </button>
    </div>
  </div>
{%- endif -%}

{%- comment -%} ─── IMAGE ZOOM MODAL ────────────────────────────────────── {%- endcomment -%}
<div class="zoom-modal" id="zoom-modal" role="dialog" aria-label="Product image zoom" aria-modal="true">
  <button class="zoom-modal__close" data-zoom-close aria-label="Close zoom">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
  </button>
  <img class="zoom-modal__img" id="zoom-img" src="" alt="{{ product.title | escape }}" loading="lazy">
</div>

{%- comment -%} ─── RELATED PRODUCTS ────────────────────────────────────── {%- endcomment -%}
{%- if section.settings.show_related -%}
  <div class="section" style="background: var(--color-bg-light);">
    <div class="page-width">
      <div class="section-heading animate-fade-up">
        <p class="section-heading__eyebrow">You May Also Like</p>
        <h2 class="section-heading__title">Related Products</h2>
      </div>
      <div class="grid grid--4-col" id="related-products">
        {%- assign related_collection = product.collections.first -%}
        {%- if related_collection -%}
          {%- for related in related_collection.products limit: 4 -%}
            {%- unless related.id == product.id -%}
              {%- render 'product-card', product: related -%}
            {%- endunless -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{%- comment -%} ─── REVIEWS SECTION ─────────────────────────────────────── {%- endcomment -%}
{%- if section.settings.show_rating -%}
  <div class="section page-width" id="product-reviews">
    <div class="section-heading animate-fade-up">
      <p class="section-heading__eyebrow">Customer Reviews</p>
      <h2 class="section-heading__title">What Our Growers Say</h2>
    </div>

    {%- comment -%} Review summary bar {%- endcomment -%}
    <div style="display:flex;align-items:center;gap:3rem;margin-bottom:3rem;flex-wrap:wrap;" class="animate-fade-up">
      <div style="text-align:center;">
        <div style="font-size:5rem;font-weight:700;color:var(--color-text-dark);line-height:1;">4.8</div>
        <div style="display:flex;gap:2px;justify-content:center;margin:0.4rem 0;">
          {%- for i in (1..5) -%}
            <svg style="width:1.8rem;height:1.8rem;fill:var(--color-star)" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          {%- endfor -%}
        </div>
        <div style="font-size:1.3rem;color:var(--color-text-light);">128 reviews</div>
      </div>
      <div style="flex:1;min-width:20rem;">
        {%- assign bars = '5,73|4,18|3,6|2,2|1,1' | split: '|' -%}
        {%- for bar in bars -%}
          {%- assign parts = bar | split: ',' -%}
          <div style="display:flex;align-items:center;gap:0.8rem;margin-bottom:0.6rem;">
            <span style="font-size:1.2rem;width:0.8rem;text-align:right">{{ parts[0] }}</span>
            <svg style="width:1.2rem;height:1.2rem;fill:var(--color-star)" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <div style="flex:1;background:var(--color-border);border-radius:10px;height:0.8rem;overflow:hidden;">
              <div style="width:{{ parts[1] }}%;height:100%;background:var(--color-star);border-radius:10px;"></div>
            </div>
            <span style="font-size:1.2rem;color:var(--color-text-light);width:2.5rem;">{{ parts[1] }}%</span>
          </div>
        {%- endfor -%}
      </div>
    </div>

    {%- comment -%} Sample reviews {%- endcomment -%}
    <div class="grid grid--3-col">
      <div class="testimonial-card animate-fade-up">
        <div class="testimonial-card__stars">
          {%- for i in (1..5) -%}<svg class="testimonial-card__star" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>{%- endfor -%}
        </div>
        <p class="testimonial-card__text">These seeds are incredible. I planted them in late spring and within two weeks I had beautiful sprouts. The germination rate was nearly 100%. Will definitely be ordering again!</p>
        <div class="testimonial-card__author">
          <div class="testimonial-card__avatar">S</div>
          <div>
            <p class="testimonial-card__name">Sarah M.</p>
            <p class="testimonial-card__date">March 2026</p>
            <p class="testimonial-card__verified">✓ Verified Buyer</p>
          </div>
        </div>
      </div>
      <div class="testimonial-card animate-fade-up animate-delay-1">
        <div class="testimonial-card__stars">
          {%- for i in (1..5) -%}<svg class="testimonial-card__star" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>{%- endfor -%}
        </div>
        <p class="testimonial-card__text">The subscription plan is such great value. I get fresh seeds every month and my garden has never looked better. Customer service was super helpful when I had questions about growing zones.</p>
        <div class="testimonial-card__author">
          <div class="testimonial-card__avatar">J</div>
          <div>
            <p class="testimonial-card__name">James R.</p>
            <p class="testimonial-card__date">February 2026</p>
            <p class="testimonial-card__verified">✓ Verified Buyer</p>
          </div>
        </div>
      </div>
      <div class="testimonial-card animate-fade-up animate-delay-2">
        <div class="testimonial-card__stars">
          {%- for i in (1..5) -%}<svg class="testimonial-card__star" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>{%- endfor -%}
        </div>
        <p class="testimonial-card__text">Certified organic and absolutely legit. I've been gardening for 20 years and these are the best heirloom seeds I've ever used. Fast shipping, beautifully packaged, 100% would recommend.</p>
        <div class="testimonial-card__author">
          <div class="testimonial-card__avatar">L</div>
          <div>
            <p class="testimonial-card__name">Linda K.</p>
            <p class="testimonial-card__date">January 2026</p>
            <p class="testimonial-card__verified">✓ Verified Buyer</p>
          </div>
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Product Information",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "checkbox",
      "id": "enable_video_looping",
      "label": "Enable video looping",
      "default": false
    },
    {
      "type": "header",
      "content": "Product Details"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show product rating",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_stock_indicator",
      "label": "Show stock indicator",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_share",
      "label": "Show social share buttons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show dynamic checkout buttons",
      "info": "Displays the payment button for the customer's preferred payment method. [Learn more](https://help.shopify.com/manual/using-themes/change-the-layout/dynamic-checkout)",
      "default": true
    },
    {
      "type": "text",
      "id": "shipping_text",
      "label": "Shipping text",
      "default": "<strong>Free shipping</strong> on orders over $50 — Ships within 2-3 business days"
    },
    {
      "type": "text",
      "id": "upsell_text",
      "label": "Upsell banner text",
      "default": "Buy 3 seed packs and <strong>save 20%</strong> — add more to your cart!"
    },
    {
      "type": "textarea",
      "id": "shipping_policy",
      "label": "Shipping & returns content",
      "default": "We ship within 2-3 business days of your order. Free standard shipping on orders over $50. Express options available at checkout.\n\nNot satisfied? Return within 30 days for a full refund — no questions asked."
    },
    {
      "type": "header",
      "content": "Additional Sections"
    },
    {
      "type": "checkbox",
      "id": "show_related",
      "label": "Show related products",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sticky_atc",
      "label": "Show sticky Add to Cart bar",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "highlight",
      "name": "Product Highlight",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Highlight text",
          "default": "100% Certified Organic & Non-GMO"
        }
      ]
    },
    {
      "type": "accordion",
      "name": "Accordion / Tab",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Growing Instructions"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Sow seeds directly outdoors after last frost, or start indoors 6-8 weeks before transplanting. Plant at a depth of 1/4 inch in well-draining soil. Keep soil evenly moist until germination (7-14 days). Thin seedlings to 12 inches apart.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Information",
      "blocks": [
        {
          "type": "highlight",
          "settings": {
            "text": "100% Certified Organic & Non-GMO"
          }
        },
        {
          "type": "highlight",
          "settings": {
            "text": "Open-pollinated heirloom varieties"
          }
        },
        {
          "type": "highlight",
          "settings": {
            "text": "90%+ germination rate guaranteed"
          }
        },
        {
          "type": "highlight",
          "settings": {
            "text": "Packed in resealable seed envelopes"
          }
        },
        {
          "type": "accordion",
          "settings": {
            "heading": "Growing Instructions",
            "content": "<p>Sow seeds directly outdoors after last frost, or start indoors 6-8 weeks before transplanting. Plant 1/4 inch deep in well-draining, fertile soil. Water regularly and thin seedlings to 12 inches apart when 2 inches tall.</p>"
          }
        },
        {
          "type": "accordion",
          "settings": {
            "heading": "Plant Details",
            "content": "<table><thead><tr><th>Detail</th><th>Value</th></tr></thead><tbody><tr><td>Days to Germination</td><td>7-14 days</td></tr><tr><td>Days to Maturity</td><td>55-65 days</td></tr><tr><td>Planting Depth</td><td>1/4 inch</td></tr><tr><td>Spacing</td><td>12 inches</td></tr><tr><td>Sun</td><td>Full sun</td></tr><tr><td>Hardiness Zone</td><td>3-11</td></tr></tbody></table>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
