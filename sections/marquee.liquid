<div class="marquee" aria-hidden="true">
  <div class="marquee__track">
    <!-- First set -->
    {% for block in section.blocks %}
      <span class="marquee__item" {{ block.shopify_attributes }}>
        <svg width="8" height="8" viewBox="0 0 8 8" fill="currentColor">
          <polygon points="4,0 8,4 4,8 0,4"/>
        </svg>
        {{ block.settings.text }}
      </span>
    {% endfor %}
    <!-- Duplicate for seamless loop -->
    {% for block in section.blocks %}
      <span class="marquee__item">
        <svg width="8" height="8" viewBox="0 0 8 8" fill="currentColor">
          <polygon points="4,0 8,4 4,8 0,4"/>
        </svg>
        {{ block.settings.text }}
      </span>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Marquee / Ticker",
  "tag": "div",
  "settings": [],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free Shipping Over $150"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Marquee",
      "blocks": [
        { "type": "item", "settings": { "text": "Free Shipping Over $150" } },
        { "type": "item", "settings": { "text": "Complimentary Gift Wrapping" } },
        { "type": "item", "settings": { "text": "Sustainably Crafted" } },
        { "type": "item", "settings": { "text": "30-Day Returns" } },
        { "type": "item", "settings": { "text": "Exclusive Members Access" } }
      ]
    }
  ]
}
{% endschema %}
