<section class="story-section section--{{ section.settings.color_scheme }}">
  <div class="container">
    <div class="story-section__grid {% if section.settings.image_position == 'right' %}story-section__grid--reverse{% endif %}">

      <div class="story-section__media">
        {% if section.settings.image != blank %}
          <img class="story-section__image"
               src="{{ section.settings.image | img_url: '800x' }}"
               alt="{{ section.settings.image.alt | default: section.settings.title }}"
               loading="lazy"
               width="800"
               height="1000">
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'story-section__image' }}
        {% endif %}
      </div>

      <div class="story-section__content">
        {% if section.settings.eyebrow != blank %}
          <p class="section__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        {% if section.settings.title != blank %}
          <h2 class="section__title">{{ section.settings.title }}</h2>
        {% endif %}
        {% if section.settings.text != blank %}
          <div style="font-size: var(--text-base); color: var(--color-text-secondary); line-height: 1.8; margin-top: var(--space-5);">
            {{ section.settings.text }}
          </div>
        {% endif %}
        {% if section.settings.btn_label != blank %}
          <div style="margin-top: var(--space-8);">
            <a href="{{ section.settings.btn_url }}" class="btn btn--primary">{{ section.settings.btn_label }}</a>
          </div>
        {% endif %}

        {% if section.blocks.size > 0 %}
          <div class="story-section__stat">
            {% for block in section.blocks %}
              <div {{ block.shopify_attributes }}>
                <p class="story-stat__number">{{ block.settings.number }}</p>
                <p class="story-stat__label">{{ block.settings.label }}</p>
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Story / About",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our Story"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Crafted with Intention"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Born from a passion for exceptional craftsmanship, Revive was founded on the belief that what you wear should reflect who you are. Each piece is thoughtfully designed, ethically produced, and built to last beyond seasons.</p><p>We work with master artisans and source only the finest materials — because true luxury is in the details.</p>"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button URL"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "darker", "label": "Dark" },
        { "value": "dark", "label": "Dark Secondary" }
      ],
      "default": "darker"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "10+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Years of Craft"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Story / About",
      "blocks": [
        { "type": "stat", "settings": { "number": "10+", "label": "Years of Craft" } },
        { "type": "stat", "settings": { "number": "50+", "label": "Master Artisans" } }
      ]
    }
  ],
  "max_blocks": 4
}
{% endschema %}
