<section class="testimonials section--{{ section.settings.color_scheme }}">
  <div class="container">

    <div class="section__header section__header--center">
      {% if section.settings.eyebrow != blank %}
        <p class="section__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h2 class="section__title">{{ section.settings.title }}</h2>
    </div>

    <div class="testimonials__grid">
      {% for block in section.blocks %}
        <div class="testimonial" {{ block.shopify_attributes }}>
          <div class="testimonial__stars">
            {% for i in (1..block.settings.rating) %}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"/>
              </svg>
            {% endfor %}
          </div>
          {% if block.settings.text != blank %}
            <p class="testimonial__text">&ldquo;{{ block.settings.text }}&rdquo;</p>
          {% endif %}
          <div class="testimonial__author">
            <strong>{{ block.settings.author }}</strong>
            {{ block.settings.location }}
          </div>
        </div>
      {% endfor %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "What Our Clients Say"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Loved by Thousands"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "darker", "label": "Dark" },
        { "value": "dark", "label": "Dark Secondary" }
      ],
      "default": "dark"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Star rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review text",
          "default": "The quality is exceptional. Every stitch, every material, every detail has been thoughtfully considered. This is what luxury truly feels like."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author name",
          "default": "Alexandra M."
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location / Verified",
          "default": "Verified Purchase"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
