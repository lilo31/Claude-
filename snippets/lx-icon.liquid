{%- comment -%}
  LEUMX — Icon set (original, thin-line 1.4px). Inherits currentColor.
  Usage: {% render 'lx-icon', icon: 'search' %}
  Icons: search, account, bag, truck, shield, sparkle, leaf, globe,
         chevron, arrow, check, plus, minus, close.
{%- endcomment -%}
{%- liquid
  assign i = icon | default: 'sparkle'
  assign sw = stroke_width | default: 1.4
-%}
<svg class="lx-svg lx-svg--{{ i }}" viewBox="0 0 24 24" fill="none"
     stroke="currentColor" stroke-width="{{ sw }}" stroke-linecap="round"
     stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case i -%}
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="6.5"/><line x1="16" y1="16" x2="21" y2="21"/>
    {%- when 'account' -%}
      <circle cx="12" cy="8" r="4"/><path d="M4.5 20a7.5 7.5 0 0 1 15 0"/>
    {%- when 'bag' -%}
      <path d="M6 8h12l-1 12H7L6 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>
    {%- when 'truck' -%}
      <path d="M2 6h12v10H2zM14 9h4l3 3v4h-7"/><circle cx="7" cy="18" r="1.8"/><circle cx="17.5" cy="18" r="1.8"/>
    {%- when 'shield' -%}
      <path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3Z"/><path d="M9 12l2 2 4-4"/>
    {%- when 'sparkle' -%}
      <path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3Z"/>
    {%- when 'leaf' -%}
      <path d="M20 4C10 4 4 10 4 20c10 0 16-6 16-16Z"/><path d="M4 20C9 15 13 11 18 6"/>
    {%- when 'globe' -%}
      <circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/>
    {%- when 'chevron' -%}
      <polyline points="9 6 15 12 9 18"/>
    {%- when 'arrow' -%}
      <line x1="4" y1="12" x2="20" y2="12"/><polyline points="14 6 20 12 14 18"/>
    {%- when 'check' -%}
      <polyline points="4 12 10 18 20 6"/>
    {%- when 'plus' -%}
      <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
    {%- when 'minus' -%}
      <line x1="5" y1="12" x2="19" y2="12"/>
    {%- when 'close' -%}
      <line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/>
    {%- else -%}
      <circle cx="12" cy="12" r="9"/>
  {%- endcase -%}
</svg>
