{% comment %}
  Product Card Snippet
  Usage: {% render 'product-card', product: product %}
{% endcomment %}

<div class="product-card">
  <div class="product-card__media">
    <a href="{{ product.url }}">
      {% if product.featured_image %}
        <img class="product-card__image"
             src="{{ product.featured_image | img_url: '600x800' }}"
             alt="{{ product.featured_image.alt | default: product.title | escape }}"
             loading="lazy"
             width="600"
             height="800">
        {% if product.images[1] %}
          <img class="product-card__image--hover"
               data-src="{{ product.images[1] | img_url: '600x800' }}"
               alt="{{ product.images[1].alt | default: product.title | escape }}"
               loading="lazy"
               width="600"
               height="800">
        {% endif %}
      {% else %}
        {{ product | img_url: '600x800' | img_tag: product.title, 'product-card__image' }}
      {% endif %}
    </a>

    <!-- Badges -->
    <div class="product-card__badges">
      {% if product.available == false %}
        <span class="product-card__badge product-card__badge--sold-out">Sold Out</span>
      {% elsif product.compare_at_price > product.price %}
        {% assign discount = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
        <span class="product-card__badge product-card__badge--sale">-{{ discount }}%</span>
      {% elsif product.created_at > 'now' | date: '%s' | minus: 2592000 | date: '%Y-%m-%d %H:%M:%S' %}
        <span class="product-card__badge">New</span>
      {% endif %}
    </div>

    <!-- Quick actions -->
    <div class="product-card__actions">
      {% unless product.has_only_default_variant %}
        <a href="{{ product.url }}" class="btn btn--primary" style="flex: 1; height: 44px; padding: 0;">
          Select Options
        </a>
      {% else %}
        <form action="/cart/add" method="post" style="flex: 1;">
          <input type="hidden" name="id" value="{{ product.variants.first.id }}">
          <button type="submit" class="btn btn--primary" style="width: 100%; height: 44px; padding: 0;"
                  {% unless product.available %}disabled{% endunless %}>
            {% if product.available %}Add to Cart{% else %}Sold Out{% endif %}
          </button>
        </form>
      {% endunless %}
      <button class="product-card__wishlist" aria-label="Add to wishlist" data-product-id="{{ product.id }}">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="product-card__info">
    {% if product.vendor %}
      <p class="product-card__vendor">{{ product.vendor }}</p>
    {% endif %}
    <a href="{{ product.url }}" class="product-card__title">{{ product.title }}</a>
    <div class="product-card__price">
      {% if product.compare_at_price > product.price %}
        <span class="product-card__price--sale">{{ product.price | money }}</span>
        <span class="product-card__price--compare">{{ product.compare_at_price | money }}</span>
      {% else %}
        <span>{{ product.price | money }}</span>
      {% endif %}
      {% if product.price_varies %}
        <span style="font-size: var(--text-sm); color: var(--color-text-muted);">From</span>
      {% endif %}
    </div>
  </div>
</div>
