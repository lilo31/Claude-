<div class="container">
  {% render 'breadcrumb' %}
</div>

<article style="padding-bottom: var(--space-24);">

  <!-- Hero Image -->
  {% if article.image %}
    <div style="width: 100%; aspect-ratio: 21/9; overflow: hidden; margin-bottom: var(--space-12);">
      <img src="{{ article.image | img_url: '1920x' }}"
           alt="{{ article.image.alt | default: article.title | escape }}"
           style="width:100%; height:100%; object-fit:cover;"
           loading="eager">
    </div>
  {% endif %}

  <div class="container">
    <div style="max-width: 760px; margin: 0 auto;">

      <!-- Meta -->
      <div style="display: flex; align-items: center; gap: var(--space-5); margin-bottom: var(--space-8);">
        {% for tag in article.tags limit: 1 %}
          <span style="font-size: var(--text-xs); letter-spacing: 0.15em; text-transform: uppercase; color: var(--color-accent);">{{ tag }}</span>
        {% endfor %}
        <span style="font-size: var(--text-xs); color: var(--color-text-muted);">
          {{ article.published_at | date: '%B %d, %Y' }}
        </span>
        {% if article.author %}
          <span style="font-size: var(--text-xs); color: var(--color-text-muted);">By {{ article.author }}</span>
        {% endif %}
      </div>

      <h1 style="font-family: var(--font-heading); font-size: clamp(var(--text-3xl), 4vw, var(--text-5xl)); font-weight: 400; line-height: 1.1; margin-bottom: var(--space-8);">
        {{ article.title }}
      </h1>

      <div class="page-content" style="padding: 0;">{{ article.content }}</div>

      <!-- Tags -->
      {% if article.tags.size > 0 %}
        <div style="margin-top: var(--space-10); padding-top: var(--space-10); border-top: 1px solid var(--color-border);">
          <span style="font-size: var(--text-xs); letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-muted); margin-right: var(--space-3);">Tags:</span>
          {% for tag in article.tags %}
            <a href="{{ blog.url }}/tagged/{{ tag | handle }}"
               style="font-size: var(--text-xs); letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-text-secondary); margin-right: var(--space-3); transition: color var(--transition-fast);"
               onmouseover="this.style.color='var(--color-accent)'"
               onmouseout="this.style.color='var(--color-text-secondary)'">
              {{ tag }}
            </a>
          {% endfor %}
        </div>
      {% endif %}

      <!-- Navigation -->
      <div style="display: flex; justify-content: space-between; margin-top: var(--space-10); padding-top: var(--space-10); border-top: 1px solid var(--color-border);">
        {% if blog.previous_article %}
          <a href="{{ blog.previous_article }}" class="btn btn--ghost" style="padding: 0; font-size: var(--text-xs);">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <line x1="19" y1="12" x2="5" y2="12"></line>
              <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            Previous
          </a>
        {% else %}
          <span></span>
        {% endif %}
        {% if blog.next_article %}
          <a href="{{ blog.next_article }}" class="btn btn--ghost" style="padding: 0; font-size: var(--text-xs);">
            Next
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        {% endif %}
      </div>

    </div>
  </div>
</article>
