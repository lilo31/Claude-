<div class="page-header">
  <div class="container">
    {% render 'breadcrumb' %}
    <h1 class="page-header__title">{{ blog.title }}</h1>
  </div>
</div>

<div class="container">
  <div style="padding: var(--space-12) 0 var(--space-24);">

    {% paginate blog.articles by 9 %}
      <div class="product-grid product-grid--3">
        {% for article in blog.articles %}
          <article>
            {% if article.image %}
              <a href="{{ article.url }}" style="display: block; overflow: hidden; aspect-ratio: 16/10; margin-bottom: var(--space-5); background: var(--color-surface);">
                <img src="{{ article.image | img_url: '800x' }}"
                     alt="{{ article.image.alt | default: article.title | escape }}"
                     loading="lazy"
                     style="width:100%; height:100%; object-fit:cover; transition: transform var(--transition-slow);"
                     onmouseover="this.style.transform='scale(1.05)'"
                     onmouseout="this.style.transform='scale(1)'">
              </a>
            {% endif %}

            <div style="padding: 0;">
              <div style="display: flex; align-items: center; gap: var(--space-4); margin-bottom: var(--space-3);">
                {% for tag in article.tags limit: 1 %}
                  <span style="font-size: var(--text-xs); letter-spacing: 0.15em; text-transform: uppercase; color: var(--color-accent);">{{ tag }}</span>
                {% endfor %}
                <span style="font-size: var(--text-xs); color: var(--color-text-muted);">
                  {{ article.published_at | date: '%B %d, %Y' }}
                </span>
              </div>

              <h2 style="font-family: var(--font-heading); font-size: var(--text-2xl); font-weight: 400; margin-bottom: var(--space-3); line-height: 1.25;">
                <a href="{{ article.url }}" style="transition: color var(--transition-fast);"
                   onmouseover="this.style.color='var(--color-accent)'"
                   onmouseout="this.style.color='inherit'">
                  {{ article.title }}
                </a>
              </h2>

              {% if article.excerpt %}
                <p style="font-size: var(--text-sm); color: var(--color-text-secondary); line-height: 1.7; margin-bottom: var(--space-5);">
                  {{ article.excerpt | strip_html | truncate: 140 }}
                </p>
              {% endif %}

              <a href="{{ article.url }}" class="btn btn--ghost" style="padding: 0; font-size: var(--text-xs);">
                Read More
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12,5 19,12 12,19"></polyline>
                </svg>
              </a>
            </div>
          </article>
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
        <div class="pagination">
          {% if paginate.previous %}
            <a href="{{ paginate.previous.url }}" class="pagination__btn">‹</a>
          {% endif %}
          {% for part in paginate.parts %}
            {% if part.is_link %}
              <a href="{{ part.url }}" class="pagination__btn">{{ part.title }}</a>
            {% else %}
              <span class="pagination__btn {% if part.title == paginate.current_page %}active{% endif %}">{{ part.title }}</span>
            {% endif %}
          {% endfor %}
          {% if paginate.next %}
            <a href="{{ paginate.next.url }}" class="pagination__btn">›</a>
          {% endif %}
        </div>
      {% endif %}
    {% endpaginate %}

  </div>
</div>
