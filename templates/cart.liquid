<div class="page-header">
  <div class="container">
    <h1 class="page-header__title">Your Cart</h1>
  </div>
</div>

<div class="container">
  <div style="padding: var(--space-12) 0 var(--space-24);">
    {% if cart.items.size > 0 %}
      <form action="/cart" method="post">
        <div style="display: grid; grid-template-columns: 1fr 360px; gap: var(--space-12); align-items: start;">

          <!-- Cart Items -->
          <div>
            <div style="display:flex; justify-content: space-between; padding-bottom: var(--space-5); border-bottom: 1px solid var(--color-border); margin-bottom: var(--space-2);">
              <span style="font-size: var(--text-xs); letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-muted);">Product</span>
              <span style="font-size: var(--text-xs); letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-muted);">Total</span>
            </div>

            {% for item in cart.items %}
              <div class="cart-item" style="grid-template-columns: 100px 1fr;">
                <a href="{{ item.url }}">
                  {% if item.image %}
                    <img class="cart-item__image"
                         src="{{ item.image | img_url: '200x' }}"
                         alt="{{ item.title | escape }}"
                         loading="lazy"
                         width="100"
                         height="133">
                  {% endif %}
                </a>
                <div class="cart-item__details">
                  <a href="{{ item.url }}" class="cart-item__title">{{ item.product_title }}</a>
                  {% unless item.variant_title == 'Default Title' %}
                    <p class="cart-item__variant">{{ item.variant_title }}</p>
                  {% endunless %}
                  <p class="cart-item__variant">{{ item.price | money }} each</p>
                  <div class="cart-item__price-row">
                    <div class="cart-item__qty">
                      <button type="button"
                              class="cart-item__qty-btn"
                              onclick="updateCartQty({{ item.variant_id }}, {{ item.quantity | minus: 1 }})"
                              aria-label="Decrease quantity">−</button>
                      <span class="cart-item__qty-count">{{ item.quantity }}</span>
                      <button type="button"
                              class="cart-item__qty-btn"
                              onclick="updateCartQty({{ item.variant_id }}, {{ item.quantity | plus: 1 }})"
                              aria-label="Increase quantity">+</button>
                    </div>
                    <span class="cart-item__price" style="font-size: var(--text-base);">{{ item.final_line_price | money }}</span>
                  </div>
                  <button type="button"
                          onclick="updateCartQty({{ item.variant_id }}, 0)"
                          style="margin-top: var(--space-3); font-size: var(--text-xs); letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-text-muted); background: none; border: none; cursor: pointer; transition: color var(--transition-fast); padding: 0;"
                          onmouseover="this.style.color='var(--color-text)'"
                          onmouseout="this.style.color='var(--color-text-muted)'">
                    Remove
                  </button>
                </div>
              </div>
            {% endfor %}

            <!-- Cart Note -->
            <div style="margin-top: var(--space-8);">
              <label class="form-label" for="cart-note">Order Note (optional)</label>
              <textarea id="cart-note"
                        name="note"
                        class="form-input"
                        style="height: 100px; resize: vertical; margin-top: var(--space-3);"
                        placeholder="Any special requests or notes for your order...">{{ cart.note }}</textarea>
            </div>
          </div>

          <!-- Order Summary -->
          <div style="background: var(--color-surface); border: 1px solid var(--color-border); padding: var(--space-8);">
            <h2 style="font-family: var(--font-heading); font-size: var(--text-xl); font-weight: 400; margin-bottom: var(--space-6);">Order Summary</h2>

            <div style="display: flex; flex-direction: column; gap: var(--space-3); margin-bottom: var(--space-6); padding-bottom: var(--space-6); border-bottom: 1px solid var(--color-border);">
              {% for item in cart.items %}
                <div style="display: flex; justify-content: space-between; font-size: var(--text-sm); color: var(--color-text-secondary);">
                  <span>{{ item.product_title }} {% unless item.variant_title == 'Default Title' %}({{ item.variant_title }}){% endunless %} &times;{{ item.quantity }}</span>
                  <span>{{ item.final_line_price | money }}</span>
                </div>
              {% endfor %}
            </div>

            <div style="display: flex; justify-content: space-between; margin-bottom: var(--space-3);">
              <span style="font-size: var(--text-sm); color: var(--color-text-secondary);">Subtotal</span>
              <span style="font-size: var(--text-base);">{{ cart.total_price | money }}</span>
            </div>

            <p style="font-size: var(--text-xs); color: var(--color-text-muted); margin-bottom: var(--space-6);">
              Shipping and taxes calculated at checkout
            </p>

            <a href="/checkout" class="btn btn--primary btn--full" style="margin-bottom: var(--space-3);">
              Proceed to Checkout
            </a>
            <a href="/collections/all" class="btn btn--outline btn--full">
              Continue Shopping
            </a>

            <!-- Trust Badges -->
            <div style="display: flex; align-items: center; justify-content: center; gap: var(--space-4); margin-top: var(--space-6); padding-top: var(--space-6); border-top: 1px solid var(--color-border);">
              {% for type in shop.enabled_payment_types %}
                {{ type | payment_type_svg_tag: class: 'site-footer__payment-icon' }}
              {% endfor %}
            </div>
          </div>

        </div>
      </form>

    {% else %}
      <div style="text-align: center; padding: var(--space-24) 0;">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="var(--color-text-muted)" stroke-width="1" style="margin: 0 auto var(--space-6);">
          <path d="m6 2 3 6h6l3-6"></path>
          <path d="M1 9h22v13H1z"></path>
        </svg>
        <h2 style="font-family: var(--font-heading); font-size: var(--text-3xl); font-weight: 400; margin-bottom: var(--space-4);">Your cart is empty</h2>
        <p style="color: var(--color-text-muted); margin-bottom: var(--space-8);">Looks like you haven't added anything yet.</p>
        <a href="/collections/all" class="btn btn--primary btn--lg">Start Shopping</a>
      </div>
    {% endif %}
  </div>
</div>

<script>
async function updateCartQty(id, qty) {
  await fetch('/cart/change.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ id, quantity: qty })
  });
  location.reload();
}
</script>
