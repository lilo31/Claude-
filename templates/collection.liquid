<div class="collection-header">
  <div class="container">
    {% render 'breadcrumb' %}
    <h1 class="collection-header__title">{{ collection.title }}</h1>
    {% if collection.description != blank %}
      <div class="collection-header__description">{{ collection.description }}</div>
    {% endif %}
  </div>
</div>

<div class="container">
  <div class="collection-layout">

    <!-- Sidebar Filters -->
    <aside class="collection-sidebar">
      {% if collection.filters.size > 0 %}
        {% for filter in collection.filters %}
          <div class="filter-group">
            <button class="filter-group__title" aria-expanded="false">
              {{ filter.label }}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="filter-options">
              {% if filter.type == 'list' %}
                {% for value in filter.values %}
                  <label class="filter-option">
                    <input type="checkbox"
                           name="{{ filter.param_name }}"
                           value="{{ value.value }}"
                           {% if value.active %}checked{% endif %}
                           onchange="this.form.submit()">
                    {{ value.label }}
                    <span style="margin-left: auto; color: var(--color-text-muted); font-size: var(--text-xs);">({{ value.count }})</span>
                  </label>
                {% endfor %}
              {% elsif filter.type == 'price_range' %}
                <div style="display:flex; gap: var(--space-3); align-items: center;">
                  <input type="number" name="{{ filter.min_value.param_name }}"
                         value="{{ filter.min_value.value | divided_by: 100 }}"
                         placeholder="{{ filter.range_min | divided_by: 100 }}"
                         class="form-input" style="width: 80px;">
                  <span>—</span>
                  <input type="number" name="{{ filter.max_value.param_name }}"
                         value="{{ filter.max_value.value | divided_by: 100 }}"
                         placeholder="{{ filter.range_max | divided_by: 100 }}"
                         class="form-input" style="width: 80px;">
                </div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      {% else %}
        <!-- Default filters when native filtering isn't available -->
        <div class="filter-group">
          <p class="filter-group__title">Price</p>
          <div class="filter-options">
            <label class="filter-option">
              <input type="checkbox"> Under $100
            </label>
            <label class="filter-option">
              <input type="checkbox"> $100 - $200
            </label>
            <label class="filter-option">
              <input type="checkbox"> Over $200
            </label>
          </div>
        </div>
        <div class="filter-group">
          <p class="filter-group__title">Availability</p>
          <div class="filter-options">
            <label class="filter-option">
              <input type="checkbox"> In Stock
            </label>
          </div>
        </div>
      {% endif %}
    </aside>

    <!-- Products -->
    <div class="collection-main">
      <div class="collection-toolbar">
        <p class="collection-toolbar__count">
          {{ collection.products_count }} product{% if collection.products_count != 1 %}s{% endif %}
        </p>
        <div class="collection-toolbar__sort">
          <label for="sort-by">Sort by</label>
          <select id="sort-by" class="collection-toolbar__sort"
                  onchange="location = '{{ collection.url }}?sort_by=' + this.value">
            <option value="manual" {% if collection.sort_by == 'manual' %}selected{% endif %}>Featured</option>
            <option value="best-selling" {% if collection.sort_by == 'best-selling' %}selected{% endif %}>Best Selling</option>
            <option value="title-ascending" {% if collection.sort_by == 'title-ascending' %}selected{% endif %}>A-Z</option>
            <option value="title-descending" {% if collection.sort_by == 'title-descending' %}selected{% endif %}>Z-A</option>
            <option value="price-ascending" {% if collection.sort_by == 'price-ascending' %}selected{% endif %}>Price: Low to High</option>
            <option value="price-descending" {% if collection.sort_by == 'price-descending' %}selected{% endif %}>Price: High to Low</option>
            <option value="created-descending" {% if collection.sort_by == 'created-descending' %}selected{% endif %}>Newest</option>
          </select>
        </div>
      </div>

      {% paginate collection.products by 12 %}
        {% if collection.products.size > 0 %}
          <div class="product-grid product-grid--3">
            {% for product in collection.products %}
              {% render 'product-card', product: product %}
            {% endfor %}
          </div>

          {% if paginate.pages > 1 %}
            <div class="pagination">
              {% if paginate.previous %}
                <a href="{{ paginate.previous.url }}" class="pagination__btn" aria-label="Previous">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <polyline points="15 18 9 12 15 6"></polyline>
                  </svg>
                </a>
              {% endif %}

              {% for part in paginate.parts %}
                {% if part.is_link %}
                  <a href="{{ part.url }}" class="pagination__btn{% if part.title == paginate.current_page %}active{% endif %}">{{ part.title }}</a>
                {% else %}
                  {% if part.title == paginate.current_page %}
                    <span class="pagination__btn active" aria-current="page">{{ part.title }}</span>
                  {% else %}
                    <span class="pagination__btn" style="border:none; cursor:default;">{{ part.title }}</span>
                  {% endif %}
                {% endif %}
              {% endfor %}

              {% if paginate.next %}
                <a href="{{ paginate.next.url }}" class="pagination__btn" aria-label="Next">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <polyline points="9 18 15 12 9 6"></polyline>
                  </svg>
                </a>
              {% endif %}
            </div>
          {% endif %}

        {% else %}
          <div style="text-align: center; padding: var(--space-16);">
            <p style="color: var(--color-text-muted); font-size: var(--text-lg);">No products found in this collection.</p>
            <a href="/collections/all" class="btn btn--outline" style="margin-top: var(--space-6);">View All Products</a>
          </div>
        {% endif %}
      {% endpaginate %}
    </div>

  </div>
</div>
