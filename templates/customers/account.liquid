<div class="page-header">
  <div class="container">
    <h1 class="page-header__title">My Account</h1>
  </div>
</div>

<div class="container">
  <div class="account-layout">

    <!-- Sidebar -->
    <aside class="collection-sidebar">
      <nav class="account-sidebar__nav">
        <a href="{{ routes.account_url }}" class="account-sidebar__link active">Orders</a>
        <a href="{{ routes.account_addresses_url }}" class="account-sidebar__link">Addresses</a>
        <a href="{{ routes.account_logout_url }}" class="account-sidebar__link">Sign Out</a>
      </nav>
    </aside>

    <!-- Content -->
    <div>
      <div style="margin-bottom: var(--space-8);">
        <p style="font-size: var(--text-sm); color: var(--color-text-muted);">
          Welcome back, <strong style="color: var(--color-text);">{{ customer.first_name }}</strong>
        </p>
      </div>

      {% if customer.orders.size > 0 %}
        <div style="border: 1px solid var(--color-border);">
          <div style="display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: var(--space-4); padding: var(--space-4) var(--space-6); border-bottom: 1px solid var(--color-border);">
            <span style="font-size: var(--text-xs); letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-muted);">Order</span>
            <span style="font-size: var(--text-xs); letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-muted);">Date</span>
            <span style="font-size: var(--text-xs); letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-muted);">Status</span>
            <span style="font-size: var(--text-xs); letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-muted); text-align: right;">Total</span>
          </div>

          {% for order in customer.orders %}
            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: var(--space-4); padding: var(--space-5) var(--space-6); border-bottom: 1px solid var(--color-border); align-items: center;">
              <a href="{{ order.customer_url }}" style="font-size: var(--text-sm); color: var(--color-accent);">{{ order.name }}</a>
              <span style="font-size: var(--text-sm); color: var(--color-text-secondary);">{{ order.created_at | date: '%b %d, %Y' }}</span>
              <span style="font-size: var(--text-xs); padding: var(--space-1) var(--space-3); background: var(--color-surface-2); color: var(--color-text-secondary); letter-spacing: 0.08em; text-transform: uppercase; display: inline-block;">
                {{ order.financial_status_label }}
              </span>
              <span style="font-size: var(--text-sm); text-align: right;">{{ order.total_price | money }}</span>
            </div>
          {% endfor %}
        </div>
      {% else %}
        <div style="text-align: center; padding: var(--space-16); background: var(--color-surface); border: 1px solid var(--color-border);">
          <p style="color: var(--color-text-muted); margin-bottom: var(--space-6);">You haven't placed any orders yet.</p>
          <a href="/collections/all" class="btn btn--primary">Start Shopping</a>
        </div>
      {% endif %}
    </div>

  </div>
</div>
