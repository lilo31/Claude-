<div class="page-header">
  <div class="container">
    <h1 class="page-header__title">Sign In</h1>
  </div>
</div>

<div class="container">
  <div style="max-width: 480px; margin: var(--space-12) auto var(--space-24);">

    {% form 'customer_login' %}
      {% if form.errors %}
        <div style="background: rgba(231,76,60,0.1); border: 1px solid #e74c3c; padding: var(--space-5); margin-bottom: var(--space-6);">
          <p style="color: #e74c3c; font-size: var(--text-sm);">{{ form.errors | default_errors }}</p>
        </div>
      {% endif %}

      <div class="form-field">
        <label class="form-label" for="login-email">Email</label>
        <input class="form-input"
               type="email"
               id="login-email"
               name="customer[email]"
               autocomplete="email"
               placeholder="your@email.com"
               required>
      </div>

      <div class="form-field">
        <label class="form-label" for="login-password">Password</label>
        <input class="form-input"
               type="password"
               id="login-password"
               name="customer[password]"
               autocomplete="current-password"
               placeholder="Your password"
               required>
      </div>

      <div style="display: flex; justify-content: flex-end; margin-bottom: var(--space-6);">
        <a href="/account/login#recover" style="font-size: var(--text-xs); color: var(--color-text-muted); letter-spacing: 0.08em;">Forgot password?</a>
      </div>

      <button type="submit" class="btn btn--primary btn--full">Sign In</button>
    {% endform %}

    <div style="margin-top: var(--space-8); padding-top: var(--space-8); border-top: 1px solid var(--color-border); text-align: center;">
      <p style="font-size: var(--text-sm); color: var(--color-text-muted);">
        Don't have an account?
        <a href="{{ routes.account_register_url }}" style="color: var(--color-accent); margin-left: var(--space-2);">Create one</a>
      </p>
    </div>

    <!-- Password Recovery -->
    <div id="recover" style="display:none; margin-top: var(--space-8); padding-top: var(--space-8); border-top: 1px solid var(--color-border);">
      <h2 style="font-family: var(--font-heading); font-size: var(--text-xl); font-weight: 400; margin-bottom: var(--space-6);">Reset Password</h2>
      {% form 'recover_customer_password' %}
        <div class="form-field">
          <label class="form-label" for="recover-email">Email</label>
          <input class="form-input"
                 type="email"
                 id="recover-email"
                 name="email"
                 placeholder="your@email.com"
                 required>
        </div>
        <button type="submit" class="btn btn--outline btn--full">Send Reset Link</button>
      {% endform %}
    </div>
  </div>
</div>

<script>
  if (window.location.hash === '#recover') {
    document.getElementById('recover').style.display = 'block';
  }
</script>
