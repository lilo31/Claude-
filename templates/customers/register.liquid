<div class="page-header">
  <div class="container">
    <h1 class="page-header__title">Create Account</h1>
  </div>
</div>

<div class="container">
  <div style="max-width: 480px; margin: var(--space-12) auto var(--space-24);">

    {% form 'create_customer' %}
      {% if form.errors %}
        <div style="background: rgba(231,76,60,0.1); border: 1px solid #e74c3c; padding: var(--space-5); margin-bottom: var(--space-6);">
          {{ form.errors | default_errors }}
        </div>
      {% endif %}

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4);">
        <div class="form-field">
          <label class="form-label" for="reg-first">First Name</label>
          <input class="form-input"
                 type="text"
                 id="reg-first"
                 name="customer[first_name]"
                 placeholder="First"
                 autocomplete="given-name">
        </div>
        <div class="form-field">
          <label class="form-label" for="reg-last">Last Name</label>
          <input class="form-input"
                 type="text"
                 id="reg-last"
                 name="customer[last_name]"
                 placeholder="Last"
                 autocomplete="family-name">
        </div>
      </div>

      <div class="form-field">
        <label class="form-label" for="reg-email">Email</label>
        <input class="form-input"
               type="email"
               id="reg-email"
               name="customer[email]"
               placeholder="your@email.com"
               autocomplete="email"
               required>
      </div>

      <div class="form-field">
        <label class="form-label" for="reg-password">Password</label>
        <input class="form-input"
               type="password"
               id="reg-password"
               name="customer[password]"
               placeholder="Min. 8 characters"
               autocomplete="new-password"
               required>
      </div>

      <button type="submit" class="btn btn--primary btn--full">Create Account</button>
    {% endform %}

    <div style="margin-top: var(--space-8); padding-top: var(--space-8); border-top: 1px solid var(--color-border); text-align: center;">
      <p style="font-size: var(--text-sm); color: var(--color-text-muted);">
        Already have an account?
        <a href="{{ routes.account_login_url }}" style="color: var(--color-accent); margin-left: var(--space-2);">Sign in</a>
      </p>
    </div>

  </div>
</div>
