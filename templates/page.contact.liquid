<div class="page-header">
  <div class="container">
    {% render 'breadcrumb' %}
    <h1 class="page-header__title">{{ page.title }}</h1>
  </div>
</div>

<div class="container">
  <div style="padding: var(--space-16) 0 var(--space-24); display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-16); align-items: start;">

    <!-- Contact Info -->
    <div>
      {% if page.content != blank %}
        <div class="page-content" style="padding: 0; max-width: none;">{{ page.content }}</div>
      {% endif %}

      <div style="margin-top: var(--space-10); display: flex; flex-direction: column; gap: var(--space-8);">
        <div>
          <p style="font-size: var(--text-xs); letter-spacing: 0.15em; text-transform: uppercase; color: var(--color-accent); margin-bottom: var(--space-3);">Email</p>
          <p style="color: var(--color-text-secondary);">hello@revivebrand.com</p>
        </div>
        <div>
          <p style="font-size: var(--text-xs); letter-spacing: 0.15em; text-transform: uppercase; color: var(--color-accent); margin-bottom: var(--space-3);">Hours</p>
          <p style="color: var(--color-text-secondary);">Monday - Friday: 9am - 6pm EST</p>
        </div>
        <div>
          <p style="font-size: var(--text-xs); letter-spacing: 0.15em; text-transform: uppercase; color: var(--color-accent); margin-bottom: var(--space-3);">Response Time</p>
          <p style="color: var(--color-text-secondary);">We aim to respond within 24 hours</p>
        </div>
      </div>
    </div>

    <!-- Contact Form -->
    <div>
      {% form 'contact' %}
        {% if form.posted_successfully? %}
          <div style="background: rgba(201,169,110,0.1); border: 1px solid var(--color-accent); padding: var(--space-5); margin-bottom: var(--space-6);">
            <p style="color: var(--color-accent); font-size: var(--text-sm);">Thank you for your message. We'll be in touch shortly.</p>
          </div>
        {% endif %}

        {% if form.errors %}
          <div style="background: rgba(231,76,60,0.1); border: 1px solid #e74c3c; padding: var(--space-5); margin-bottom: var(--space-6);">
            {% for field in form.errors %}
              <p style="color: #e74c3c; font-size: var(--text-sm);">{{ field | capitalize }}: {{ form.errors.messages[field] }}</p>
            {% endfor %}
          </div>
        {% endif %}

        <div class="form-field">
          <label class="form-label" for="contact-name">Name</label>
          <input class="form-input"
                 type="text"
                 id="contact-name"
                 name="contact[name]"
                 value="{{ form.name }}"
                 placeholder="Your full name"
                 required>
        </div>

        <div class="form-field">
          <label class="form-label" for="contact-email">Email</label>
          <input class="form-input"
                 type="email"
                 id="contact-email"
                 name="contact[email]"
                 value="{{ form.email }}"
                 placeholder="your@email.com"
                 required>
        </div>

        <div class="form-field">
          <label class="form-label" for="contact-phone">Phone (optional)</label>
          <input class="form-input"
                 type="tel"
                 id="contact-phone"
                 name="contact[phone]"
                 value="{{ form.phone }}"
                 placeholder="+1 (555) 000-0000">
        </div>

        <div class="form-field">
          <label class="form-label" for="contact-subject">Subject</label>
          <select class="form-input form-select" id="contact-subject" name="contact[subject]">
            <option value="">Select a topic...</option>
            <option value="order">Order Inquiry</option>
            <option value="returns">Returns & Exchanges</option>
            <option value="product">Product Question</option>
            <option value="other">Other</option>
          </select>
        </div>

        <div class="form-field">
          <label class="form-label" for="contact-message">Message</label>
          <textarea class="form-input"
                    id="contact-message"
                    name="contact[body]"
                    style="height: 160px; resize: vertical;"
                    placeholder="How can we help you?"
                    required>{{ form.body }}</textarea>
        </div>

        <button type="submit" class="btn btn--primary btn--full">Send Message</button>
      {% endform %}
    </div>

  </div>
</div>
